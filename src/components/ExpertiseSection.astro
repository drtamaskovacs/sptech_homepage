---
// ExpertiseSection.astro

// Define the type for expertise items
interface ExpertiseItem {
  title: string;
  description: string;
  imageUrl: string;
  imageAlt: string;
}

// You can import this from a separate data file
// e.g., import { expertiseItems } from '../data/expertise';
const expertiseItems: ExpertiseItem[] = [
  {
    title: "Data & AI Platform",
    description: "Designing, building, and operating modern data and AI platforms - from data hubs to log archives and private LLM infrastructure",
    imageUrl: "/expertise/data-platforms.png",
    imageAlt: "Data & AI Platform",
  },
  {
    title: "AI & Analytics",
    description: "Turning data into actionable insights through business intelligence, advanced analytics, and AI-powered applications.",
    imageUrl: "/expertise/Analytics_shiftedup.png",
    imageAlt: "AI & Analytics",
  },
  {
    title: "Data Security",
    description: "Protecting sensitive data and infrastructure through secure architectures, anonymization, system hardening, and monitoring.",
    imageUrl: "/expertise/DataSecurity_shiftedup.png",
    imageAlt: "Data Security",
  },
  {
    title: "DevOps & Automation",
    description: "Automating deployments, infrastructure, and operations to ensure reliability, scalability, and continuous monitoring.",
    imageUrl: "/expertise/DevOPs_shiftedup.png",
    imageAlt: "DevOps & Automation",
  },
];

interface Props {
  title?: string;
  subtitle?: string;
  items?: ExpertiseItem[];
}

const { title = "Our Services", subtitle = "We design, build, secure, optimize, and operate modern data platforms and AI solutions.", items = expertiseItems } = Astro.props;
---

<section id="our-services" class="bg-custom-blue-gradient relative scroll-mt-16">
  <div class="container mx-auto section-y">
    <h2 class="font-square text-center text-5xl font-bold mb-5 text-blue-400">{title}</h2>
    <p class="text-center text-gray-300 section-subtitle-gap max-w-3xl mx-auto">
      {subtitle}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      {
        items.map((item) => (
          <div class="relative rounded-lg border border-slate-600 overflow-hidden transition-transform duration-300 hover:-translate-y-1 h-80">
            {/* Background image covering the entire card */}
            <img src={item.imageUrl} alt="" class="absolute inset-0 w-full h-full object-cover" />

            {/* Gradient overlay - from transparent at top to black at bottom */}
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/50 to-transparent" />

            {/* Content positioned at the bottom */}
            <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
              <h3 class="text-white text-xl font-bold mb-2">{item.title}</h3>
              <p class="text-gray-300 text-sm">{item.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
