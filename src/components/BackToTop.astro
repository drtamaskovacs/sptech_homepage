---
// BackToTop.astro - floating "scroll to top" button
---

<button
  id="back-to-top"
  aria-label="Back to top"
  class="fixed bottom-6 right-6 z-50 flex size-11 items-center justify-center rounded-full text-white bg-[#172B4D] hover:bg-[#329CF0] border border-[#3B82F6] shadow-lg shadow-black/30 opacity-0 invisible translate-y-2 transition-all duration-200 ease-in-out"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <line x1="12" y1="19" x2="12" y2="5"></line>
    <polyline points="5 12 12 5 19 12"></polyline>
  </svg>
</button>

<script is:inline>
  function initBackToTop() {
    const btn = document.getElementById("back-to-top");
    if (!btn) return;

    const toggle = () => {
      if (window.scrollY > 400) {
        btn.classList.remove("opacity-0", "invisible", "translate-y-2");
      } else {
        btn.classList.add("opacity-0", "invisible", "translate-y-2");
      }
    };

    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    window.addEventListener("scroll", toggle, { passive: true });
    toggle();
  }

  document.addEventListener("astro:after-swap", initBackToTop);
  initBackToTop();
</script>
