---
interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  emailAddress?: string;
}
const { 
  title = "Have a Project in mind?", 
  subtitle = "Ready to transform your data strategy? Let's talk.",
  buttonText = "Let's Connect",
  emailAddress = "info@sptech.ch"
} = Astro.props;
---

<section class="bg-slate-900 section-y relative border-y-slate-500 border-y mix-blend-lighten">
  <div class="container mx-auto">
    <div class="flex flex-col items-center justify-center gap-6 text-center">
      <!-- Heading -->
      <h2 class="font-square text-5xl font-bold text-blue-400 mb-2">
        {title}
      </h2>
      
      <!-- Subtitle -->
      <p class="text-gray-300 max-w-lg mb-8">
        {subtitle}
      </p>
      
      <!-- Email Button with Icon -->
      <a
        href={`mailto:${emailAddress}`}
        class="inline-flex items-center justify-center px-12 py-4 text-2xl font-square text-white rounded border border-blue-600 hover:bg-[#1d293d] transition-colors duration-300 gap-3"
      >
        <!-- Mail Icon (SVG) -->
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span>{buttonText}</span>
      </a>
    </div>
  </div>
</section>