---
// AIDiagnosticsSection.astro

interface Step {
  number: string;
  title: string;
  description: string;
}

const steps: Step[] = [
  {
    number: "01",
    title: "Submit",
    description: "Provide your database diagnostic statistics for analysis. No direct database access required.",
  },
  {
    number: "02",
    title: "Diagnose",
    description: "AI-assisted analysis identifies inefficient queries, indexing issues, performance anomalies, and potential root causes.",
  },
  {
    number: "03",
    title: "Optimize",
    description: "Receive a prioritized findings report and a tailored optimization plan. Our engineers can help implement and validate the improvements.",
  },
];
---

<section id="ai-diagnostics" class="bg-[#0b1120] section-y relative scroll-mt-16">
  <div class="container mx-auto grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    <!-- Left: copy + CTA -->
    <div>
      <span class="inline-block rounded bg-[#B91C1C] text-white text-xs font-bold uppercase tracking-wider px-3 py-1.5">
        Featured Service
      </span>

      <h2 class="font-square text-5xl font-bold text-blue-400 mt-6 mb-6">
        AI Database Diagnostics & Optimization
      </h2>

      <p class="text-xl md:text-2xl font-bold text-white mb-6">
        Find out what's slowing down your database. And how to fix it.
      </p>

      <p class="text-gray-300 max-w-xl mb-6">
        AI-driven analysis of query performance, execution plans, indexes, and database
        statistics identifies bottlenecks and their potential root causes. Get prioritized
        findings and actionable optimization recommendations - backed by our engineers to
        help you implement improvements.
      </p>

      <a
        href="mailto:info@sptech.ch"
        class="inline-block rounded bg-blue-500 hover:bg-blue-600 text-white font-medium px-6 py-3 transition-colors duration-300 ease-in-out"
      >
        Request a Diagnostic
      </a>
    </div>

    <!-- Right: steps -->
    <div class="space-y-5">
      {
        steps.map((step) => (
          <div class="flex gap-5 items-start rounded-xl border border-blue-900/40 bg-linear-to-br from-slate-900 to-[#0d1b33] p-6">
            <div class="font-square text-2xl md:text-3xl font-bold text-blue-500 leading-none shrink-0">
              {step.number}
            </div>
            <div>
              <h3 class="text-white font-bold text-lg mb-1">{step.title}</h3>
              <p class="text-gray-400 text-sm">{step.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
